IDD_HELP_DIALOG DIALOGEX 0, 0, 300, 295
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Firmware Writing Information"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Saving vs. Writing",IDC_HELP_H1,7,7,286,10
    LTEXT           "Saving will create a new file with any edits you have made in iPodWizard. Writing will overwrite/replace the file you are editing.",IDC_STATIC,7,19,286,18
    LTEXT           "This means ""Write to iPod"" will replace the firmware currently loaded to your iPod. It is important for you to create backups by using the firmware extractor.",IDC_STATIC,7,39,286,18
    LTEXT           "Reflashing",IDC_HELP_H2,7,63,286,10
    LTEXT           "When writing a firmware to your iPod, the pop-up warning will display whether or not it will be reflashed.",IDC_STATIC,7,75,286,18
    LTEXT           "Reflashing is not required to write a firmware to your iPod. Reflashing and overwriting firmwares are not the same.",IDC_STATIC,7,95,286,18
    LTEXT           "Reflashing is the process of forcing an update to the iPod's ROM. It will produce a\n""Plug in"" screen which will prevent any further action until plugged in. iPods require a specific charger to reflash.",IDC_STATIC,7,115,286,26
    LTEXT           "Plug-in reflash information",IDC_HELP_H3,7,147,286,10
    LTEXT           "iPod 1/2G\niPod 3G\niPod 4G\niPod 5/5.5G\niPod mini\niPod nano",IDC_STATIC,14,159,60,52
    LTEXT           "FireWire\nFireWire\nFireWire*\nAny USB\nFireWire*\nAny USB",IDC_STATIC,78,159,100,52
    LTEXT           "* - Apple iPod USB charger, specific to 2004-2007 iPods. Some 3rd party or newer Apple chargers will function, however it is hard to identify which will work, so assume a FireWire requirement.",IDC_STATIC,7,215,286,26
    LTEXT           "It is essential to own a FireWire power source if you are planning to reflash the firmware. If you do not own one, enable the 'Never reflash' setting in the preferences. iPodWizard may reflash despite this setting, so use with caution.",IDC_STATIC,7,245,286,26
    DEFPUSHBUTTON   "Close",IDOK,122,275,56,14
END

IDD_THEME_HELP DIALOGEX 0, 0, 300, 236
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Making a theme"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "To make a custom theme, save each asset you have modified. For example: if you have only edited graphics, you only need to provide graphics.",IDC_STATIC,7,7,286,22
    LTEXT           "The names of each asset must be unchanged from their exported versions.",IDC_STATIC,7,33,286,22
    LTEXT           "Graphics:",IDC_THEMEHELP_B1,7,59,48,10
    LTEXT           "You can individually save modified bitmaps or 'Save All'.",IDC_STATIC,57,59,236,22
    LTEXT           "Fonts:",IDC_THEMEHELP_B2,7,83,48,10
    LTEXT           "If you have modified a font, 'Save Font' is easiest to include, or you can export both the metrics && bitmap.",IDC_STATIC,57,83,236,32
    LTEXT           "Strings:",IDC_THEMEHELP_B3,7,117,48,10
    LTEXT           "Save the modified language block as a string list with 'Save List'.",IDC_STATIC,57,117,236,22
    LTEXT           "Resources:",IDC_THEMEHELP_B4,7,141,48,10
    LTEXT           "You can save individual resources with 'Save Resource' or 'Save All' if you made a larger modification.",IDC_STATIC,57,141,236,32
    LTEXT           "Once you have saved all of the modified assets, you must load the firmware the theme is built for before placing the assets into the 'Custom Theme' maker. Ensure the String Index matches your language block.",IDC_STATIC,7,179,286,32
    DEFPUSHBUTTON   "Close",IDOK,122,215,56,14
END

