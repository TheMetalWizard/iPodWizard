STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_VISIBLE | WS_SYSMENU
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CTEXT           "iPod Firmware Extraction",IDC_STATIC,0,7,441,12
    CTEXT           "Note: Before modifying your iPod's firmware, make a backup using the extractor!",IDC_STATIC,31,20,379,8
    CTEXT           "It's good practice to name and organize your firmware files well. A good organization scheme will streamline the modification and archival process.",IDC_STATIC,31,32,379,17
    CTEXT           "It is recommended to organize your folders by unmodified and modified firmware files, and by the iPod model, e.g. custom > 5.5g > MyCustomFile_v1.bin",IDC_STATIC,31,53,379,17
    CTEXT           "Note: You must name your file. Recommended naming schemes include the working name of the file, such as a project name and the version number, however the name can be anything you want.",IDC_STATIC,31,74,379,17
    PUSHBUTTON      "Extract firmware from iPod",IDC_EXTRACTIPOD_BUTTON,170,97,100,15
END

